---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, GITHUB_URL, LINKEDIN_URL } from '../consts';
---

<BaseLayout title="contact" description="Get in touch with Jake Van Slyke">
  <h1>contact</h1>
  <p>Email is the best way to reach me — it goes straight to my inbox.</p>

  <p class="mail">
    <a href={`mailto:${CONTACT_EMAIL}`}>
      <span class="icon" aria-hidden="true">&#xf0e0;</span> {CONTACT_EMAIL}
    </a>
  </p>

  <p>
    <a href={GITHUB_URL}><span class="icon" aria-hidden="true">&#xf09b;</span> github</a> ·
    <a href={LINKEDIN_URL}><span class="icon" aria-hidden="true">&#xf0e1;</span> linkedin</a>
  </p>
</BaseLayout>

<style>
  .mail {
    margin: 1.5rem 0;
    font-size: 1.125rem;
  }
  .mail::before {
    content: '> ';
    color: var(--comment);
  }
</style>

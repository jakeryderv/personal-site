---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GITHUB_URL, LINKEDIN_URL } from '../consts';
---

<BaseLayout title="about" description="About Jake Van Slyke">
  <h1>about</h1>

  <p>
    Hi — I'm Jake, a student at the
    <a href="https://www.ou.edu/polytechnic">University of Oklahoma Polytechnic Institute</a>
    studying applied artificial intelligence. Most of my work lives where ML meets
    engineering: training a JetBot to race in NVIDIA Isaac Sim before it ever touches
    real hardware, composing computer-vision pipelines, and building the LLM and agent
    infrastructure I want to use instead of waiting for someone else to ship it.
  </p>

  <h2>skills</h2>
  <ul class="skills">
    <li>Python</li>
    <li>TypeScript</li>
    <li>C++</li>
    <li>PyTorch</li>
    <li>NVIDIA Isaac Sim / Isaac Lab</li>
    <li>OpenCV</li>
    <li>reinforcement learning</li>
    <li>scikit-learn</li>
    <li>FastAPI</li>
    <li>PostgreSQL</li>
    <li>Docker</li>
    <li>LLM &amp; agent tooling</li>
  </ul>

  <h2>currently</h2>
  <p>
    <em>(Placeholder — current projects land here soon.)</em>
  </p>

  <h2>education</h2>
  <p>
    <strong>University of Oklahoma Polytechnic Institute</strong> —
    <a href="https://www.ou.edu/polytechnic">Applied Artificial Intelligence</a>
  </p>

  <h2>elsewhere</h2>
  <p>
    <a href={GITHUB_URL}><span class="icon" aria-hidden="true">&#xf09b;</span> github</a> ·
    <a href={LINKEDIN_URL}><span class="icon" aria-hidden="true">&#xf0e1;</span> linkedin</a> ·
    <a href="/contact/"><span class="icon" aria-hidden="true">&#xf0e0;</span> contact form</a>
  </p>
</BaseLayout>

<style>
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }
  .skills li {
    color: var(--yellow);
    background: var(--bg2);
    padding: 0.1em 0.6em;
    border-radius: 999px;
    font-size: 0.9em;
  }
</style>
